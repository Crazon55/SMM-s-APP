{
  "name": "dos-server",
  "version": "1.0.0",
  "description": "DOS V1 Central Orchestrator",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');const p=require('path');const d=p.join('dist','db');if(!fs.existsSync(d))fs.mkdirSync(d,{recursive:true});fs.copyFileSync(p.join('src','db','schema.sql'),p.join(d,'schema.sql'));\"",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "db:init": "tsx src/db/init.ts",
    "test": "vitest run",
    "test:acceptance": "vitest run --config vitest.acceptance.config.ts"
  },
  "dependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.6.3",
    "better-sqlite3": "^11.6.0",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "multer": "^1.4.5-lts.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "vitest": "^2.1.4"
  }
}
